 "blocks": [
  {
   "id": "zoku-gunsho-onoko-nyobo-0001",
   "pid": "nao-731728",
   "pages": [
    1
   ],
   "text": "もこかよとこにちかみたちわたるちんのまくらか右いふやうわかせこかたひ手のやとになかむらんゆみとりの月といひて持になりぬ永延二年七月廿七日男女房歌合同朝臣家訟合一条院御時也松とこ女の歌合は天徳の例によりてなり一暮花色暁虫声松下聞風水辺待月夜人左小将君為親朝臣茂賢行頼加賀守友範侍従徳門君右近君七",
   "poems": []
  },
  {
   "id": "zoku-gunsho-onoko-nyobo-0002",
   "pid": "nao-731728",
   "pages": [
    2
   ],
   "text": "男女房のうたよみ出の〳〵はけみて題をいたしてよめる暮花色左小将君露出きてあすもみるへき色なれとくれゆらをしき本の色かなけふもあゝかなとも加賀守友範右ほのかなるをかはわかねとはなの色のきりたちまさる秋の夕暮暁虫声左為親秋の夜のあか月かけてなくむしは草の宿りもつゆけかりける右勝侍従包絶へすあけゆくそらになく書は秋のねさめのかすをし給ふ松下聞風茂賢松の葉に秋ふし風の出ときけはくもらぬめめにそてそぬれける右勝衛門君むかしよりならふともなきことのねをひけはたかはぬ松のうは風水辺詩月左行願おとはやまなかれていつる水のかもにおくれてみえぬ月をしそまつ",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6",
    "7"
   ]
  },
  {
   "id": "zoku-gunsho-onoko-nyobo-0003",
   "pid": "nao-731728",
   "pages": [
    3
   ],
   "text": "右右近君なみのうへにはおもいろをはをかなめて水は量らぬ月をしやまて内裏歌合右方後番承暦二年四月晦日子日霞鶯楼藤花菖蒲五月雨郭公七夕月鹿紅葉雪祝亥歌人保実朝臣美作君作匡房朝臣通俊朝臣伊家通浦頭綱朝臣何通家",
   "poems": [
    "8"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "露出きてあすもみるへき色なれとくれゆらをしき本の色かな",
   "kana": "",
   "speaker": "小将君",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "ほのかなるをかはわかねとはなの色のきりたちまさる秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "秋の夜のあか月かけてなくむしは草の宿りもつゆけかりける",
   "kana": "",
   "speaker": "為親",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "4",
   "text": "包絶へすあけゆくそらになく書は秋のねさめのかすをし給ふ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": "勝侍従"
  },
  {
   "seq": "5",
   "text": "松の葉に秋ふし風の出ときけはくもらぬめめにそてそぬれける",
   "kana": "",
   "speaker": "茂賢",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "勝侍従"
  },
  {
   "seq": "6",
   "text": "むかしよりならふともなきことのねをひけはたかはぬ松のうは風",
   "kana": "",
   "speaker": "衛門君",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "7",
   "text": "おとはやまなかれていつる水のかもにおくれてみえぬ月をしそまつ",
   "kana": "",
   "speaker": "行願",
   "page": 2,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "8",
   "text": "なみのうへにはおもいろをはをかなめて水は量らぬ月をしやまて",
   "kana": "",
   "speaker": "右近君",
   "page": 3,
   "pid": "nao-731728",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "右",
   "dai": "勝"
  }
 ],
